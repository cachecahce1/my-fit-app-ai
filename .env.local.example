# Copy to .env.local and fill from your Supabase project:
# supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Photo → macro estimates (openrouter.ai → Keys). Server-side only, never shipped to the browser.
OPENROUTER_API_KEY=sk-or-...
# Optional: which vision model estimates macros (default openai/gpt-5-mini)
MEAL_MODEL=openai/gpt-5.6-luna
